# Copy to .env and fill in. Relative paths are resolved against backend/.

# --- ingest ---
LOG_PATH=../data/logs/app.log
TAIL_POLL_MS=200
TAIL_FROM_START=false

# --- detection ---
BUCKET_SECONDS=5
WINDOW_SECONDS=60
BASELINE_POINTS=60
WARMUP_POINTS=12
Z_LOW=3
Z_MEDIUM=5
Z_HIGH=8
CRITICAL_ERROR_RATE=0.5
MIN_VOLUME=20
MIN_ABS_DELTA=0.02
MAD_FLOOR=0.005
SILENCE_SECONDS=15
RECENT_BUCKETS=3

# --- incidents ---
RESOLVE_TICKS=3
CORRELATION_SECONDS=20

# --- generator ---
GENERATOR_ENABLED=true
GENERATOR_RATE=40
LOG_MAX_BYTES=50000000

# --- sinks (DRY_RUN logs payloads instead of sending) ---
DRY_RUN=true
AWS_REGION=ap-south-1
SNS_TOPIC_ARN=
CW_LOG_GROUP=/sentinel/alerts
CW_LOG_STREAM=demo

# --- narrator (optional; template fallback is used when empty) ---
ANTHROPIC_API_KEY=
